<?xml version="1.0" encoding="utf-8"?>
<!--
  autounattend.xml — авто-запуск оптимизации при первом входе в Windows.
  КУДА ПОЛОЖИТЬ: в КОРЕНЬ установочной флешки (рядом с папками sources, boot).
  Что делает: НИЧЕГО не меняет в самой установке Windows. Только при первом
  входе ищет optimize.ps1 на диске с проектами (D:/E:/F:) и запускает его.
  Если файла нет — просто ничего не произойдёт, установка обычная.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Auto optimize Windows</Description>
          <RequiresUserInput>false</RequiresUserInput>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$p=@('D:\Projects\WinSetup\optimize.ps1','E:\Projects\WinSetup\optimize.ps1','F:\Projects\WinSetup\optimize.ps1','G:\Projects\WinSetup\optimize.ps1') | Where-Object { Test-Path $_ } | Select-Object -First 1; if($p){ Start-Process powershell.exe -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File',$p }"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
